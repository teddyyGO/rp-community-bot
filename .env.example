# ---- rp-community-bot :: environment ----
# Copy to .env for local dev. On a host like Railway, set these as service variables.

# Discord bot token (NEVER commit this). Required.
TOKEN=

# Application (client) id - used to register slash commands. Required.
CLIENT_ID=

# Optional: register commands to a single guild for instant updates during dev.
# Leave empty in production to register commands globally.
GUILD_ID=

# Display name used in embeds and the admin panel.
COMMUNITY_NAME=My RP Community

# Community clock: fixed offset from UTC in hours (no DST), and the hour the
# "day" starts for daily peaks/analytics. e.g. UTC_OFFSET_HOURS=4, DAY_START_HOUR=6
UTC_OFFSET_HOURS=0
DAY_START_HOUR=6

# Tracked servers + pinned-embed channels. Defaults to ./servers.json (see
# servers.example.json). SERVERS_JSON (inline JSON, same shape) is used when the
# file does not exist - handy on hosts with an ephemeral filesystem.
SERVERS_CONFIG=
SERVERS_JSON=

# Postgres connection string. If unset, the bot runs DB-less using local file fallbacks.
DATABASE_URL=

# Admin web panel key (login password). Required to open the panel.
# Use a long random value, e.g. `openssl rand -hex 32`. NEVER log or commit this.
ADMIN_KEY=

# Port for the admin panel / health check. Most hosts set PORT automatically.
PORT=3000
# ADMIN_PORT is an optional override if you don't want to use PORT.
ADMIN_PORT=

# Session cookie secret for the admin panel. Optional. The signing secret is
# always also bound to ADMIN_KEY, so rotating ADMIN_KEY invalidates old sessions.
SESSION_SECRET=
# Bump this (any new value) to force-revoke ALL existing admin sessions.
SESSION_EPOCH=
